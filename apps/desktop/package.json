{
  "name": "@violin/desktop",
  "productName": "Violin Practice",
  "version": "0.0.1",
  "description": "Electron desktop app for the violin practice project (Finger Tuner + Playing Practice). Mic/line-in capture -> packages/dsp-ts's validated YIN pipeline -> packages/core, behind a real Finger Tuner UI (Phase 5) with a collapsible debug panel.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worklet.json"
  },
  "keywords": [],
  "author": {
    "name": "burak.ucbinli",
    "email": "burakucbinli@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.9.0",
    "electron": "44.2.0",
    "typescript": "~6.0.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@violin/core": "workspace:*",
    "@violin/dsp-ts": "workspace:*",
    "electron-squirrel-startup": "^1.0.1"
  }
}
